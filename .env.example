# Backends of the observed system (defaults match iot-observability-demo)
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
MIMIR_URL=http://localhost:9009

# The model. Anything LiteLLM can reach that supports required tool calls.
#
# Two routes, don't mix them (see llm.py):
#   provider/model  -> LiteLLM goes to that provider and reads ITS key from the
#                      env. For the default below that means MISTRAL_API_KEY.
#   bare-name       -> treated as an OpenAI-compatible endpoint: LLM_BASE_URL
#                      and LLM_API_KEY are used.
AGENT_MODEL=mistral/codestral-2508
MISTRAL_API_KEY=

# Only for the bare-name route:
# LLM_BASE_URL=https://your-gateway/v1
# LLM_API_KEY=
