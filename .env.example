# Backends of the observed system (defaults match iot-observability-demo)
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
MIMIR_URL=http://localhost:9009

# The model. Anything LiteLLM can reach that supports required tool calls.
#
# Two routes, don't mix them (see llm.py):
#   provider/model  -> LiteLLM goes to that provider and reads ITS key from the
#                      env. For the default below that means MISTRAL_API_KEY.
#   bare-name       -> treated as an OpenAI-compatible endpoint: LLM_BASE_URL
#                      and LLM_API_KEY are used.
AGENT_MODEL=mistral/codestral-2508
MISTRAL_API_KEY=

# Other providers, same route (LiteLLM reads each one's own key):
# AGENT_MODEL=gemini/gemini-3.8-flash      + GEMINI_API_KEY=
# AGENT_MODEL=openai/<model>               + OPENAI_API_KEY=
# AGENT_MODEL=anthropic/<model>            + ANTHROPIC_API_KEY=
#
# Only for the bare-name route (a gateway, or a local server):
# AGENT_MODEL=<model name as the endpoint lists it>
# LLM_BASE_URL=https://your-gateway/v1     # LM Studio: http://localhost:1234/v1
# LLM_API_KEY=                             # leave empty for a local server
#
# Whatever you pick must support tool_choice="required": the agent never
# accepts prose where a tool call is expected.
